{
  "name": "nlpp-ts-server",
  "version": "0.1.0",
  "description": "Language tooling for the NL++ pseudocode language — syntax highlighting, diagnostics, completions, hover, folding, go-to-definition, and preprocessing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nlpp-compile": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run scripts/codegen.ts && bun build index.ts src/cli.ts --outdir dist --target node --format esm --external web-tree-sitter --external nlpp-grammar && tsc -p tsconfig.build.json",
    "test": "bun test",
    "prepublishOnly": "bun test && bun run build",
    "demo": "bun scripts/demo.ts",
    "docs": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stur86/nlpp-ts-server.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "Simone Sturniolo",
    "email": "simonesturniolo@gmail.com"
  },
  "keywords": [
    "nlpp",
    "tree-sitter",
    "language-server",
    "syntax-highlighting",
    "pseudocode"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.1",
    "typedoc": "^0.28.19",
    "typescript": "^5"
  },
  "dependencies": {
    "nlpp-grammar": "^1.0.1",
    "web-tree-sitter": "^0.25.0"
  }
}
